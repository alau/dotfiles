#!/bin/bash
set -euo pipefail

read -r -d '' BASE << 'BASEJSON' || true
{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "*docker *",
      "*uv run pytest*",
      "*just test*"
    ],
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com"
      ]
    },
    "filesystem": {
      "denyRead": ["~/", "/root", "/srv", "/mnt", "/media"],
      "allowRead": [
        "~/repos",
        "~/.local/share/chezmoi",
        "~/.agents",
        "~/.claude",
        "~/.gitconfig",
        "~/.local/bin",
        "~/.cargo",
        "~/.pyenv",
        "~/.nvm",
        "~/go",
        "~/.cache/go-build",
        "~/.cache/uv",
        "~/.cache/pip",
        "~/.ripgreprc"
      ],
      "allowWrite": [
        "~/repos",
        "~/.cache/go-build",
        "~/go/pkg/mod",
        "~/.cache/uv"
      ]
    },
    "credentials": {
      "files": [
        { "path": "~/.ssh", "mode": "deny" },
        { "path": "~/.aws", "mode": "deny" },
        { "path": "~/.config/gh", "mode": "deny" },
        { "path": "~/.config/gcloud", "mode": "deny" },
        { "path": "~/.kube", "mode": "deny" },
        { "path": "~/.docker/config.json", "mode": "deny" },
        { "path": "~/.npmrc", "mode": "deny" },
        { "path": "~/.claude/.credentials.json", "mode": "deny" },
        { "path": "~/.zshrc.local", "mode": "deny" },
        { "path": "~/.zshenv.local", "mode": "deny" },
        { "path": "~/.zlogin.local", "mode": "deny" },
        { "path": "~/.tmux.conf.local", "mode": "deny" }
      ]
    }
  },
  "tui": "fullscreen",
  "respectGitignore": true,
  "permissions": {
    "allow": [
      "Bash(make *)",
      "Bash(go test *)",
      "Bash(go build *)",
      "Bash(go vet *)",
      "Bash(go run *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(ls *)",
      "Bash(which *)",
      "Bash(git stash list*)",
      "Bash(git remote*)",
      "Bash(git tag*)",
      "Bash(wc *)",
      "Bash(file *)",
      "Bash(type *)",
      "Read(~/.claude/plugins/**)",
      "WebSearch",
      "WebFetch",
      "mcp__github__get_me",
      "mcp__github__get_file_contents",
      "mcp__github__get_commit",
      "mcp__github__search_code",
      "mcp__github__search_repositories",
      "mcp__github__search_issues",
      "mcp__github__search_pull_requests",
      "mcp__github__list_issues",
      "mcp__github__list_pull_requests",
      "mcp__github__list_commits",
      "mcp__github__list_branches",
      "mcp__github__list_tags",
      "mcp__github__list_releases",
      "mcp__github__issue_read",
      "mcp__github__pull_request_read",
      "mcp__clickup__clickup_get_task",
      "mcp__clickup__clickup_filter_tasks",
      "mcp__clickup__clickup_get_custom_fields",
      "mcp__clickup__clickup_list_document_pages",
      "mcp__clickup__clickup_get_document_pages",
      "mcp__clickup__clickup_get_task_comments"
    ],
    "deny": [
      "Read(./.env)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.zshrc.local)",
      "Read(~/.zshenv.local)",
      "Read(~/.zlogin.local)",
      "Read(~/.tmux.conf.local)"
    ],
    "defaultMode": "plan"
  },
  "model": "opusplan",
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true
  },
  "effortLevel": "max",
  "vimMode": true,
  "lspDiagnostics": {
    "enabled": true,
    "languages": [
      "python",
      "go",
      "lua"
    ]
  },
  "hooks": {
    "PreToolUse": [{
      "matcher": "Bash",
      "hooks": [{ "type": "command",
        "command": "/home/alau/.claude/hooks/rtk-rewrite.sh"
      }]
    }]
  },
  "env": {
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1",
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0"
  },
  "awaySummaryEnabled": false,
  "disableAutoMode": "disable",
  "statusLine": {
    "type": "command",
    "command": "claude-powerline"
  }
}
BASEJSON

LOCAL="$HOME/.claude/settings.local.json"

if [ -f "$LOCAL" ]; then
  printf '%s' "$BASE" | jq --slurpfile local "$LOCAL" '. * $local[0]'
else
  printf '%s' "$BASE"
fi
